  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@bitriel/eslint-config": "workspace:*",
    "@expo/metro": "^0.1.1",
    "@expo/metro-runtime": "~6.1.2",
    "@testing-library/react-native": "^13.2.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.4",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.12",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2"
  },
  "eslintConfig": {
    "extends": "@bitriel/eslint-config",
    "ignorePatterns": [
